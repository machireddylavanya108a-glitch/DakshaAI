import { createRoot } from 'react-dom/client'
import App from './App.jsx'
import './styles/globals.css'
import { installProductionOptimizations } from './utils/productionOptimizations.js'

const AUTH_ROUTE_PATTERN = /^(\/login|\/signup|\/register|\/forgot-password|\/auth(?:\/|$))/i;
const AUTH_SW_CLEANUP_FLAG = 'daksha-auth-sw-cleanup';

function isAuthRoute(pathname = window.location.pathname) {
  return AUTH_ROUTE_PATTERN.test(pathname || '/');
}

async function clearServiceWorkerForAuth() {
  if (!('serviceWorker' in navigator)) {
    return false;
  }

  try {
    const registrations = await navigator.serviceWorker.getRegistrations();
    await Promise.all(registrations.map((registration) => registration.unregister()));
  } catch (error) {
    console.error('Unable to unregister service workers for auth flow:', error);
  }

  try {
    const cacheNames = await caches.keys();
    await Promise.all(cacheNames.filter((cacheName) => cacheName.startsWith('daksha-')).map((cacheName) => caches.delete(cacheName)));
  } catch (error) {
    console.error('Unable to clear Daksha caches for auth flow:', error);
  }

  return true;
}

async function initializeServiceWorkerPolicy() {
  if (!('serviceWorker' in navigator)) {
    return;
  }

  const shouldDisable = isAuthRoute(window.location.pathname);
  if (shouldDisable) {
    const cleaned = await clearServiceWorkerForAuth();
    const alreadyReloaded = window.sessionStorage.getItem(AUTH_SW_CLEANUP_FLAG) === '1';

    if (cleaned && !alreadyReloaded) {
      window.sessionStorage.setItem(AUTH_SW_CLEANUP_FLAG, '1');
      window.location.reload();
    }
    return;
  }

  if (import.meta.env.PROD) {
    navigator.serviceWorker.register('/sw.js').catch((error) => console.error('Service worker registration failed:', error));
    return;
  }

  await clearServiceWorkerForAuth();
}

window.addEventListener('load', () => {
  void initializeServiceWorkerPolicy();
});

window.addEventListener('popstate', () => {
  void initializeServiceWorkerPolicy();
});

const originalPushState = window.history.pushState.bind(window.history);
window.history.pushState = function patchedPushState(...args) {
  const result = originalPushState(...args);
  void initializeServiceWorkerPolicy();
  return result;
};

const originalReplaceState = window.history.replaceState.bind(window.history);
window.history.replaceState = function patchedReplaceState(...args) {
  const result = originalReplaceState(...args);
  void initializeServiceWorkerPolicy();
  return result;
};

installProductionOptimizations();

createRoot(document.getElementById('root')).render(
  <App />,
)
